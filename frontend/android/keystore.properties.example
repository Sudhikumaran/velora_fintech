# Copy to keystore.properties (gitignored) for signed release APK/AAB.
# Generate keystore once:
#   keytool -genkey -v -keystore velora-release.keystore -alias velora -keyalg RSA -keysize 2048 -validity 10000
storeFile=../velora-release.keystore
storePassword=your_store_password
keyAlias=velora
keyPassword=your_key_password
