<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_payment_popup"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Payment detected"
        android:textColor="#6366F1"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/popup_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="₹—"
        android:textColor="#111827"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/popup_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Add this in Velora"
        android:textColor="#4B5563"
        android:textSize="14sp" />

    <Button
        android:id="@+id/popup_add"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#6366F1"
        android:text="Add this payment"
        android:textAllCaps="false"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/popup_skip"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:backgroundTint="#F3F4F6"
        android:text="Not now"
        android:textAllCaps="false"
        android:textColor="#4B5563" />
</LinearLayout>
